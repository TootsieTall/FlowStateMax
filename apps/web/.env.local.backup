# ============================================================================
# FlowState Development Environment - Quick Access Mode
# ============================================================================

# Disable OAuth completely (no Google sign-in button)
NEXT_PUBLIC_ENABLE_OAUTH=false

# Enable guest onboarding (can use app without authentication)
NEXT_PUBLIC_ALLOW_GUEST_ONBOARDING=true

# Development mode (quick test user access)
NEXT_PUBLIC_DEV_MODE=true

# NextAuth Configuration
NEXTAUTH_SECRET=dev-secret-key-for-local-development-only
NEXTAUTH_URL=http://localhost:3000

# Development Guest User ID
DEV_GUEST_USER_ID=dev-user-001

# Database Connection
DATABASE_URL="postgresql://postgres:Ad215143421%21@db.iqdomkoxncawrzwrrydr.supabase.co:5432/postgres"
