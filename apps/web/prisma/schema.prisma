// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Onboarding
  onboardingComplete Boolean           @default(false)
  goals             String[]          // Array of focus areas
  
  // Settings
  flowLocations     FlowLocation[]
  blockedApps       BlockedApp[]
  ritual            RitualItem[]
  podcastGenres     String[]          // Selected podcast genres
  
  // Data
  timeBlocks        TimeBlock[]
  tasks             Task[]
  flowSessions      FlowSession[]
  shutdownLogs      ShutdownLog[]
  dailyGoals        DailyGoal[]
  
  // Accounts
  accounts          Account[]
  sessions          Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FlowLocation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  latitude  Float
  longitude Float
  radius    Int      @default(100) // meters
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockedApp {
  id            String   @id @default(cuid())
  userId        String
  name          String
  identifier    String   // Bundle ID or package name
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, identifier])
}

model RitualItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  order     Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeBlock {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        BlockType  @default(DEEP_WORK)
  color       String?
  completed   Boolean    @default(false)
  taskId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

enum BlockType {
  DEEP_WORK
  MEETING
  BREAK
  GYM
  SHALLOW
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  impact      Impact    @default(LOW)
  deadline    DateTime?
  completed   Boolean   @default(false)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeBlocks TimeBlock[]
}

enum Impact {
  HIGH
  LOW
}

model FlowSession {
  id           String   @id @default(cuid())
  userId       String
  startTime    DateTime
  endTime      DateTime?
  duration     Int?     // minutes
  locationId   String?
  feedback     String?  // "on_time", "needed_more", "finished_early"
  monochromeOn Boolean  @default(false)
  appsBlocked  Boolean  @default(false)
  musicPlayed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShutdownLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  brainDump   String?  @db.Text
  tomorrowTop String[] // Top 3 tasks for tomorrow
  alarmsSet   String[] // Times of alarms set
  completed   Boolean  @default(true)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  goals     String[] // 1-3 major goals
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
}